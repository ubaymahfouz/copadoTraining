<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:azure-service-bus-messaging="http://www.mulesoft.org/schema/mule/azure-service-bus-messaging" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core 
	http://www.mulesoft.org/schema/mule/core/current/mule.xsd
	http://www.mulesoft.org/schema/mule/json-logger 
	http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd
	http://www.mulesoft.org/schema/mule/http 
	http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
	http://www.mulesoft.org/schema/mule/ee/core 
	http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/azure-service-bus-messaging http://www.mulesoft.org/schema/mule/azure-service-bus-messaging/current/mule-azure-service-bus-messaging.xsd">
	<sub-flow name="post-interests" doc:id="0b682ab6-3c82-4b00-8cd9-68d7ab8bf457">
		<json-logger:logger doc:name="Functional Log" doc:id="ba214598-90f0-4d72-8ed0-3d17f8d6ff16" config-ref="JSON_Functional_Logger_Config"
			message='#["Message to POST interests received, about to check if the interests are for a new or existing Customer."]' tracePoint="BEFORE_REQUEST"
			category="nl.swisssense.attributes">
			<json-logger:content><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<ee:transform doc:name="Set origin and originalPayload variables" doc:id="a850c87b-f0a3-45ea-8809-58e7c07033fb" >
			<ee:variables >
				<ee:set-variable variableName="origin" ><![CDATA[attributes.queryParams.origin default ""]]></ee:set-variable>
				<ee:set-variable variableName="originalPayload" ><![CDATA[payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<json-logger:logger-scope doc:name="Logger scope" doc:id="b08d1bff-da86-4f26-a5b0-7f13876f1eeb"
			configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http">
			<http:request method="GET" doc:name="GET Customers by email @ Customers PL" doc:id="8adc5fb3-ac73-46f0-bbfe-eacecbc49972"
				config-ref="HTTPS_Request_Customers_PL_configuration" path="${secure::https.request.customers-pl.customers.path}">
				<reconnect frequency="${secure::https.reconnection.frequency}" count="${secure::https.reconnection.attempts}" />
				<http:query-params><![CDATA[#[output application/java
---
{
	"email" : payload.email,
	"target" : "salesforce"
}]]]></http:query-params>
			</http:request>
		</json-logger:logger-scope>
		<set-variable value="#[(payload.customers orderBy ($.lastModifiedDate))[-1]]" doc:name="Set Variable lastModifiedGetCustomersResponse"
			doc:id="e41787e7-641c-4d71-b04b-48391bcfbe13" variableName="lastModifiedGetCustomersResponse" />
		<json-logger:logger doc:name="DEBUG Logger" doc:id="bf277ba4-9304-487d-9f72-aeea21e1f800" config-ref="JSON_Logger_Config"
			message="The full message before determining whether a new Customer needs to be created." tracePoint="AFTER_REQUEST" priority="DEBUG"
			category="nl.swisssense.payload">
			<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes,
    origin: vars.origin,
    originalPayload: vars.originalPayload,
    (lastModifiedCustomer: vars.lastModifiedGetCustomersResponse) if (vars.lastModifiedGetCustomersResponse != null)
}]]]></json-logger:content>
		</json-logger:logger>
		<choice doc:name="Is the customer known (update) or unknown (create)?" doc:id="c04ca90f-1423-4a8e-ac4c-b094d82e4dc5">
			<when expression="#[payload.customers != []]">
				<json-logger:logger doc:name="Debug Log" doc:id="0644f322-d33d-42e8-b8f9-822ad201d4cb" config-ref="JSON_Logger_Config"
					message="Response received from Customers PL, processing each of the returned Customer(s) belonging to the input values."
					tracePoint="AFTER_REQUEST" category="nl.swisssense.attributes" priority="DEBUG">
					<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes
}]]]></json-logger:content>
				</json-logger:logger>
				<foreach doc:name="For Each" doc:id="7ff4f1b3-15a8-4953-ab4a-53a2784767c6" collection="#[payload.customers]"
					counterVariableName="customerCounter" rootMessageVariableName="customers">
					<json-logger:logger doc:name="Functional Log" doc:id="2e97296b-b180-4e73-a2ae-0d6306b5fa08" config-ref="JSON_Functional_Logger_Config"
						message='#["Processing PATCH Customer for: " ++ payload.globalCustomerId default "" ++ " (globalCustomerId)."]' tracePoint="BEFORE_REQUEST"
						category="nl.swisssense.attributes">
						<json-logger:content><![CDATA[null]]></json-logger:content>
					</json-logger:logger>
					<flow-ref doc:name="post-interests_patch-customer" doc:id="e9a08b07-0b86-40e3-ab45-80e25d1ebcd9" name="post-interests_patch-customer" />
				</foreach>
			</when>
			<otherwise>
				<json-logger:logger doc:name="Debug Log" doc:id="7bdda85c-f2a5-4d0c-872a-43a56f12d778" config-ref="JSON_Logger_Config"
					message="No response received from Customers PL, creating new Lead for the given details (which are saved in originalPayload)."
					tracePoint="BEFORE_TRANSFORM" category="nl.swisssense.attributes" priority="DEBUG">
					<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes
}]]]></json-logger:content>
				</json-logger:logger>
				<ee:transform doc:name="POST customer (lead) request mapping" doc:id="fec5f4d6-7242-4ab5-b140-045f2029b3e7">
					<ee:message>
						<ee:set-payload resource="dwl/post-customers-to-customers-pl-request-mapping.dwl" />
					</ee:message>
				</ee:transform>
				<json-logger:logger-scope doc:name="Logger scope" doc:id="47b8e755-1066-4ba2-bc4e-b2074a889823"
					configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http">
					<http:request method="POST" doc:name="POST Customers @ Customers PL, response in postCustomersResponse variable" doc:id="012858a9-b002-41c8-8dbf-c75de7f571ad"
						config-ref="HTTPS_Request_Customers_PL_configuration" path="${secure::https.request.customers-pl.customers.path}" target="postCustomersResponse">
						<reconnect frequency="${secure::https.reconnection.frequency}" count="${secure::https.reconnection.attempts}" />
						<http:query-params><![CDATA[#[output application/java
---
{
	"origin" : vars.origin
}]]]></http:query-params>
					</http:request>
				</json-logger:logger-scope>
			</otherwise>
		</choice>
		<choice doc:name="Does the request contain a configurator?" doc:id="4f06734a-f097-4fdb-ae23-31bbb6184d50">
			<when expression="#[vars.originalPayload.interestData != null]">
				<json-logger:logger doc:name="Functional Log" doc:id="9dbd1c68-54bc-4747-97b5-0215082210a9" config-ref="JSON_Functional_Logger_Config"
					message="Interests of the Customer(s) have been updated. About to POST a request to Salesforce Marketing Cloud or Insider now."
					tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes">
					<json-logger:content><![CDATA[null]]></json-logger:content>
				</json-logger:logger>
				<json-logger:logger-scope doc:name="Logger scope" doc:id="a7390475-225d-494b-9bc1-2dd082ba33c4" configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http">
					<http:request method="GET" doc:name="GET customerids by globalCustomerId @ Customer Reference SL" doc:id="2f6018c7-3519-48d8-ac43-9ad7b70642a5" config-ref="HTTP_Request_Customer-Reference_SL_configuration" path="${secure::https.request.customer-reference-sl.global.id.path}" target="customerRefResponse">
						<http:uri-params ><![CDATA[#[output application/java
---
{
	"globalcustomerid" : if (vars.lastModifiedGetCustomersResponse != null) vars.lastModifiedGetCustomersResponse.globalCustomerId else vars.postCustomersResponse.globalCustomerId
}]]]></http:uri-params>
					</http:request>
				</json-logger:logger-scope>
				<scatter-gather doc:name="Scatter-Gather" doc:id="5718d3d2-9c8e-424e-b286-0f3c0dde4bb9" >
					<route >
						<choice doc:name="Choice" doc:id="dcca6075-e051-454c-a2fa-770560a4130a">
					<when expression='#[p("insider_switch.sfmc_active") == true]'>
						<ee:transform doc:name="POST configurators request mapping" doc:id="365de60e-ea00-4de0-b64b-6226211395ae">
					<ee:message>
						<ee:set-payload resource="dwl/post-configurators-to-salesforce-marketing-cloud-sl-request-mapping.dwl" />
					</ee:message>
				</ee:transform>
						<http:request method="POST" doc:name="POST Configurators @ Salesforce Marketing Cloud SL" doc:id="f6f969cc-83ae-48e9-986b-b38b47548cea" config-ref="HTTPS_Request_Salesforce-Marketing-Cloud_SL_configuration" path="${secure::https.request.salesforce-marketing-cloud-sl.configurators.path}">
						<reconnect frequency="${secure::https.reconnection.frequency}" count="${secure::https.reconnection.attempts}" />
					</http:request>
					</when>
				</choice>
					</route>
					<route >
						<flow-ref doc:name="Flow Reference" doc:id="f6f35f4c-bfc1-4030-ada2-be92a3440195" name="insider_user_upsert" />
					</route>
				</scatter-gather>
			</when>
			<otherwise>
				<json-logger:logger doc:name="Functional Log" doc:id="a11ea97b-8f42-47f5-a7e4-37d7b6807c3e" config-ref="JSON_Functional_Logger_Config"
					message="No InterestData found for SFMC, flow execution finalized." tracePoint="AFTER_REQUEST" category="nl.swisssense.attributes">
					<json-logger:content><![CDATA[null]]></json-logger:content>
				</json-logger:logger>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="insider_user_upsert" doc:id="2356f09d-3e3d-4179-a38b-d03a5eb1e34b" >
		<json-logger:logger doc:name="Functional Log" doc:id="b10a6a30-a734-464d-82fd-a1ad05f6a323" config-ref="JSON_Functional_Logger_Config" message="Interests of the Customer(s) have been updated. About to UPSERT a request to Insider now." tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes" >
			<json-logger:content ><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<ee:transform doc:name="advisors/configurators mapping" doc:id="3b91e243-856f-4cbf-8cfa-9692281e6248" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable resource="dwl/post-configurators-to-insider-boxspring-configurator-mapping.dwl" variableName="boxspring_configurator" />
				<ee:set-variable resource="dwl/post-configurators-to-insider-advisors-mapping.dwl" variableName="advisors" />
			</ee:variables>
		</ee:transform>
		<set-variable doc:name="Set advisors/configurators payload" doc:id="491d762e-1f64-4dc0-8490-8aa06bf786c3" variableName="payload" value='#[output application/json&#10;---&#10;{&#10;	"body": if(vars.advisors != null) vars.advisors&#10;			else if (vars.boxspring_configurator != null) vars.boxspring_configurator&#10;			else null&#10;}]'/>
		<json-logger:logger doc:name="Functional" doc:id="b1810cb1-7b41-4c92-bacc-fb5ab13d98fa" config-ref="JSON_Functional_Logger_Config" message="About to send advisor/configurator payload to queue - insider-user-upsert" tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes">
		</json-logger:logger>
		<azure-service-bus-messaging:send doc:name="Send to insider-user-upsert q" doc:id="4cf30cb6-9b98-4cac-b4a5-abf5838e984c" config-ref="Azure_Service_Bus_Messaging_Connector_Config" destinationName="${azure.servicebus.destination.quote.insider-user-upsert.q}">
			<azure-service-bus-messaging:body ><![CDATA[#[vars.payload.body]]]></azure-service-bus-messaging:body>
		</azure-service-bus-messaging:send>
	</sub-flow>
	<flow name="post-interestsFlow" doc:id="e3549c35-d53d-4ce4-8bc9-ef46b68ea38e" >
		<azure-service-bus-messaging:message-listener doc:name="Message listener" doc:id="ad73ae1f-7570-4ec9-b51f-83d0c05acf42" config-ref="Azure_Service_Bus_Messaging_Connector_Config" ackMode="AUTO" destinationName="${azure.servicebus.destination.quote.insider-user-upsert.q}"/>
		<ee:transform doc:name="Set originalPayload variable" doc:id="898949ee-19c2-463f-a5dc-f97498ada84e" >
			<ee:variables >
				<ee:set-variable variableName="originalPayload" ><![CDATA[payload]]></ee:set-variable>
				<ee:set-variable variableName="insiderEventToken" ><![CDATA[%dw 2.0
output application/json
---
{
   requestToken: p("azure-vault::insider-x-request-token")
}]]></ee:set-variable>
				<ee:set-variable variableName="insiderEventPartner" ><![CDATA[%dw 2.0
output application/json
---
{
  name: p("azure-vault::insider-x-partner-name")
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<json-logger:logger doc:name="Functional" doc:id="d98cae66-c25c-499c-9a71-8959be2f7af7" config-ref="JSON_Logger_Config" message='#["About to post user upsert to insider"]' tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes" >
			<json-logger:content ><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<json-logger:logger-scope doc:name="Logger scope" doc:id="fd5c751f-e174-481a-a7fb-425e5f5f0778" configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http" >
			<http:request method="POST" doc:name="Insider API - user upsert" doc:id="0f71cb5c-ea3a-4035-995f-a3fe05460a55" config-ref="HTTP_Request_configuration_insider_event_configuration" path="${secure::https.request.insider.event.path}" correlationId="#[vars.correlationId]" >
				<http:body ><![CDATA[#[vars.originalPayload]]]></http:body>
				<http:headers ><![CDATA[#[output application/java
---
{
    "X-REQUEST-TOKEN" : vars.insiderEventToken.requestToken,
    "X-PARTNER-NAME" : vars.insiderEventPartner.name
}]]]></http:headers>
			</http:request>
		</json-logger:logger-scope>
		<json-logger:logger doc:name="DEBUG Logger" doc:id="bee850b1-1f8e-4e8c-b60d-dfea495cf265" config-ref="JSON_Logger_Config" message="Successfully received profile upsert response from insider API" tracePoint="AFTER_REQUEST" priority="DEBUG" category="nl.swisssense.payload" correlationId="#[vars.correlationId]" >
			<json-logger:content ><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes,
    (vars: vars) if (vars != null)
}]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="insider email send" doc:id="d5cfa6a7-9802-4d6d-9141-df35d46c4eb1" name="insider_email_send" targetValue="#[vars.originalPayload]"/>
	</flow>
	<sub-flow name="insider_email_send" doc:id="2497e361-9eff-473a-add5-790ebeeb067b" >
		<json-logger:logger doc:name="Functional Log" doc:id="ff9f8f03-9f26-405f-839e-bd93cd4ffe07" config-ref="JSON_Functional_Logger_Config" message="Interests of the Customer(s) have been updated. About to UPSERT a request to Insider now." tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes" >
			<json-logger:content ><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<ee:transform doc:name="Transactional emails mapping" doc:id="ea326a68-e983-4878-8c62-f14789e5daaa" >
			<ee:message />
			<ee:variables >
				<ee:set-variable resource="dwl/transactional-emails-boxspring-configurator-mapping.dwl" variableName="boxspring-configurator" />
				<ee:set-variable resource="dwl/transactional-emails-advisors.dwl" variableName="advisors" />
			</ee:variables>
		</ee:transform>
		<json-logger:logger doc:name="Functional" doc:id="19e27f19-3db2-44f6-b255-5264cf34b7f5" config-ref="JSON_Functional_Logger_Config" message="About to send advisor/configurator payload to queue - insider-user-upsert" tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes" />
		<azure-service-bus-messaging:send destinationName="${azure.servicebus.destination.quote.insider-user-upsert.q}" doc:name="Send to insider-user-upsert q" doc:id="b5f4abd4-012e-447f-ab9c-58daeafb4ecf" config-ref="Azure_Service_Bus_Messaging_Connector_Config" >
			<azure-service-bus-messaging:body ><![CDATA[#[vars.payload.body]]]></azure-service-bus-messaging:body>
		</azure-service-bus-messaging:send>
	</sub-flow>
	<sub-flow name="post-interests_patch-customer" doc:id="193d4ca7-ccb4-4028-9902-29ffd62e2b39">
		<choice doc:name="Is the customerType known?" doc:id="4f4074bf-8fb7-4976-b758-7652ce5ad507">
			<when
				expression='#[(payload.systemCustomerIds.*customerType contains ("lead")) or (payload.systemCustomerIds.*customerType contains ("customer"))]'>
				<json-logger:logger doc:name="Functional Log" doc:id="4b3e7120-19df-4fff-aba5-053d30b6ca4a" config-ref="JSON_Functional_Logger_Config"
					message="Doing PATCH for Customer (Lead or Account)." tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes">
					<json-logger:content><![CDATA[null]]></json-logger:content>
				</json-logger:logger>
				<ee:transform doc:name="PATCH customer request mapping" doc:id="76768bcd-855e-45bc-992a-5ef0a89d39db">
					<ee:message>
						<ee:set-payload resource="dwl/patch-customer-to-salesforce-sl-request-mapping.dwl" />
					
</ee:message>
				</ee:transform>
				<json-logger:logger-scope doc:name="Logger scope" doc:id="b701ff34-0326-4446-be8d-cb88d9442675"
					configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http">
					<http:request method="PATCH" doc:name="PATCH Customer by SalesforceCustomerId @ Salesforce SL"
						doc:id="d2abf1be-23b9-4ee4-aab7-04233ee96d93" config-ref="HTTPS_Request_Salesforce_SL_configuration"
						path="${secure::https.request.salesforce-sl.customers.salesforcecustomerid.path}">
						<reconnect frequency="${secure::https.reconnection.frequency}" count="${secure::https.reconnection.attempts}" />
						<http:uri-params><![CDATA[#[output application/java
---
{
	"salesforcecustomerid" : payload.customerId
}]]]></http:uri-params>
					</http:request>
				</json-logger:logger-scope>
			</when>
			<otherwise>
				<json-logger:logger doc:name="Error Log" doc:id="3e6bbd62-50c0-4bb0-bc1e-3f3610549d51" config-ref="JSON_Logger_Config"
					message="Unknown customerType." tracePoint="EXCEPTION" category="nl.swisssense.attributes">
					<json-logger:content><![CDATA[#[output application/json ---
{
 	attributes: attributes
}]]]></json-logger:content>
				</json-logger:logger>
				<json-logger:logger doc:name="DEBUG Log" doc:id="dced8fd7-18d0-4ff2-88f1-4fb86d754701" config-ref="JSON_Logger_Config"
					message="Default choice route taken, incorrect/invalid customerType." tracePoint="EXCEPTION" priority="DEBUG" category="nl.swisssense.payload">
					<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes
}]]]></json-logger:content>
				</json-logger:logger>
				<raise-error doc:name="Raise error" doc:id="96ff3fd1-dc97-4902-b870-682c4ba0b738" type="SWISS_SENSE:MULE_CHOICE_ERROR"
					description='#["Default choice route taken, incorrect/invalid customerType."]' />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
