		</json-logger:logger-scope>
		<json-logger:logger doc:name="Functional" doc:id="cc97453d-dc7f-4caa-ad9f-197f30558884" config-ref="JSON_Functional_Logger_Config" message="Post Quote SF Response" tracePoint="AFTER_REQUEST" category="nl.swisssense.attributes" correlationId="#[vars.correlationId]" >
