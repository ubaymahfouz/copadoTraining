			config-ref="JSON_Functional_Logger_Config" message="About to send quote's payload with URL to ASB queue - Quote Step 1" 
			tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes">
			<json-logger:content><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<azure-service-bus-messaging:send doc:name="Send Quote Step 1" doc:id="cf45b8d1-9399-4f8f-9761-e330e8ea19fb"
			destinationName="${azure.servicebus.destination.quote.step1.q}" sendCorrelationStrategy="ALWAYS"
			config-ref="Azure_Service_Bus_Messaging_Connector_Config">
			<reconnect frequency="${azure.servicebus.reconnection.frequency}" count="${azure.servicebus.reconnection.attempts}" />
		</azure-service-bus-messaging:send>
		<json-logger:logger doc:name="DEBUG" doc:id="395519bd-b146-4696-b95c-9cc37e1062af" config-ref="JSON_Logger_Config"
			message='#["quote data with URL - after sending the payload to ASB queue"]' tracePoint="AFTER_REQUEST" category="nl.swisssense.payload"
