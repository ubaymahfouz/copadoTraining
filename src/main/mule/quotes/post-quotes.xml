	<flow name="listener-quote-step1" doc:id="3c20e8da-7beb-435c-992f-f57979b1f38d">
		<azure-service-bus-messaging:message-listener doc:name="Quote Step 1"
			doc:id="74864158-d047-4e0a-8350-66280c0b27f3" config-ref="Azure_Service_Bus_Messaging_Connector_Config" ackMode="AUTO"
			destinationName="${azure.servicebus.destination.quote.step1.q}" />
		<set-variable value="#[attributes.correlationId]" doc:name="correlationId" doc:id="f77ae47d-d1fc-4cd2-86da-b7f8dbfa6a22" variableName="correlationId" />
		<json-logger:logger doc:name="DEBUG" doc:id="fc07db9c-0ae9-45df-9409-8c8b7175f242" config-ref="JSON_Logger_Config"
			message='#["Quote Step 1 - input payload"]' priority="DEBUG" category="nl.swisssense.payload" tracePoint="FLOW" correlationId="#[vars.correlationId]">
			<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes,
    (vars: vars) if (vars != null)
}]]]></json-logger:content>
		</json-logger:logger>
		<choice doc:name="Choice" doc:id="cbcb84c1-c5e3-44ae-b6c0-572c372f424b">
			<when expression='#[payload.customer.id == null or payload.customer.id == ""]'>
				<flow-ref doc:name="quote-step-1-create-customer-flow" doc:id="24678f53-7527-4e91-931a-9c13aa4695c4" name="quote-step-1-create-customer-flow"/>
			</when>
			<otherwise>
				<flow-ref doc:name="quote-step-1-update-customer-flow" doc:id="bb4e0db2-4f65-4960-a6c4-e4d817cd2bd1" name="quote-step-1-update-customer-flow"/>
			</otherwise>
		</choice>
		<json-logger:logger doc:name="Functional" doc:id="171344b4-6e64-482b-8a08-031c8b03cecc" config-ref="JSON_Functional_Logger_Config" 
				message="About to send quote's payload with URL to ASB queue - Quote Step 2" tracePoint="BEFORE_REQUEST" category="nl.swisssense.attributes" correlationId="#[vars.correlationId]">
			<json-logger:content ><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<json-logger:logger doc:name="DEBUG" doc:id="c82086db-4c69-4159-b971-b24f817a5fbd" config-ref="JSON_Logger_Config" message='Quote data with customer id - just before sending to the Queue quote step2' tracePoint="AFTER_TRANSFORM" priority="DEBUG" category="nl.swisssense.payload" correlationId="#[vars.correlationId]">
			<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes,
    (vars: vars) if (vars != null)
}]]]></json-logger:content>
		</json-logger:logger>
		<azure-service-bus-messaging:send destinationName="${azure.servicebus.destination.quote.step2.q}" doc:name="Send Quote Step 2" 
				doc:id="3ecd23e4-e89b-4737-b452-1af1a769ecb4" config-ref="Azure_Service_Bus_Messaging_Connector_Config" sendCorrelationStrategy="ALWAYS" correlationId="#[vars.correlationId]">
			<reconnect frequency="${azure.servicebus.reconnection.frequency}" count="${azure.servicebus.reconnection.attempts}" />
		</azure-service-bus-messaging:send>
	</flow>

