	<sub-flow name="post-quotes-orchestration" doc:id="ede4e939-60c4-4c8f-bbd8-619eab42a7e2">
		<json-logger:logger doc:name="Functional" doc:id="fb70de2a-dca0-46c3-94e8-4385620026fb"
			config-ref="JSON_Functional_Logger_Config" message='About to POST quote @ Document Generation System API' tracePoint="BEFORE_REQUEST"
			category="nl.swisssense.attributes">
			<json-logger:content><![CDATA[null]]></json-logger:content>
		</json-logger:logger>
		<json-logger:logger-scope doc:name="Logger scope" doc:id="e8bb74d4-b7d9-48ad-8078-793c58514af5"
			configurationRef="JSON_Logger_Config" priority="DEBUG" category="nl.swisssense.tracking.http">
			<http:request method="POST" doc:name="Document Generation System API - Create Document" doc:id="ee24afa4-071a-4e82-b540-2bd82899bdd8"
