		<json-logger:logger doc:name="DEBUG" doc:id="dfc786f6-c2b8-43c1-b306-802cd166c88e" config-ref="JSON_Logger_Config"
			message='#["POST quote response in vars.documentResponse"]' tracePoint="AFTER_REQUEST" category="nl.swisssense.payload" priority="DEBUG">
			<json-logger:content><![CDATA[#[import modules::JSONLoggerModule output application/json ---
{
    (payload: JSONLoggerModule::stringifyNonJSON(payload)) if (payload != null),
    attributes: attributes,
    (vars: vars) if (vars != null)
}]]]></json-logger:content>
		</json-logger:logger>
